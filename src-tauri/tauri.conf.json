{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flappyflight",
  "version": "0.2.0",
  "identifier": "com.flappyflight.app",
  "build": {
    "frontendDist": "../SRC"
  },
  "app": {
    "windows": [
      {
        "title": "flappyflight",
        "width": 460,
        "height": 700,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "An event-driven Flappy Bird clone.",
    "longDescription": "Flappy Flight runs entirely offline in its own desktop window. No Python, no server, no setup — just double-click and play.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
